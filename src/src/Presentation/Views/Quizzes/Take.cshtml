@model QuizApp.Application.DTOs.Attempt.TakeQuizDto
@using QuizApp.Domain.Enums

@{
    ViewData["Title"] = "Take Quiz";

    // The server calculates the remaining time. This avoids time zone and clock differences.
    // The Take action must set ExpiresAt from DateTime.UtcNow.
    var remainingSeconds = Math.Max(0, (int)(Model.ExpiresAt - DateTime.UtcNow).TotalSeconds);
}

<!-- STICKY TIMER HEADER -->
<div class="timer-sticky">
    <div>
        <h4 class="mb-0">@Model.Title</h4>
        <small class="text-muted">Answer carefully. The quiz submits automatically when time runs out.</small>
    </div>
    <div class="timer-display" id="countdown" role="timer">Loading...</div>
</div>

<div class="container py-5">
    <form asp-action="Submit" method="post" id="quizForm">
        <input type="hidden" name="AttemptId" value="@Model.AttemptId" />
        <input type="hidden" name="QuizId" value="@Model.QuizId" />

        @for (var i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];

            <div class="question-block">
                <h5>Question @(i + 1)</h5>
                <p>@question.Text</p>

                <input type="hidden" name="Submissions[@i].QuestionId" value="@question.QuestionId" />

                @if (question.QuestionType == QuestionType.ShortAnswer)
                {
                    <input type="text" name="Submissions[@i].UserAnswer" class="form-control"
                           autocomplete="off" aria-label="Answer for question @(i + 1)" />
                }
                else
                {
                    foreach (var option in question.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="Submissions[@i].SelectedOptionId"
                                   value="@option.Id" id="opt_@option.Id" />
                            <label class="form-check-label" for="opt_@option.Id">@option.Text</label>
                        </div>
                    }
                }
            </div>
        }

        <button type="submit" class="btn btn-primary" id="submitButton">Submit Quiz</button>
    </form>
</div>

<script>
    (function() {
        const form = document.getElementById('quizForm');
        const submitButton = document.getElementById('submitButton');
        const timerElement = document.getElementById('countdown');

        // Only the elapsed time matters here, so the clock of the user's computer does not.
        const endAt = Date.now() + @remainingSeconds * 1000;
        let countdownId = null;
        let isSubmitting = false;

        function getSecondsLeft() {
            return Math.max(0, Math.ceil((endAt - Date.now()) / 1000));
        }

        function render(secondsLeft) {
            const minutes = Math.floor(secondsLeft / 60);
            const seconds = secondsLeft % 60;
            timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            timerElement.classList.toggle('text-danger', secondsLeft < 60);
        }

        function lockForm() {
            isSubmitting = true;
            submitButton.disabled = true;
        }

        function autoSubmit() {
            if (isSubmitting) return;

            clearInterval(countdownId);
            lockForm();
            timerElement.textContent = "Time's up! Submitting...";
            timerElement.classList.add('text-danger', 'fw-bold');
            form.submit();
        }

        function tick() {
            const secondsLeft = getSecondsLeft();

            if (secondsLeft <= 0) {
                autoSubmit();
                return;
            }

            render(secondsLeft);
        }

        // Manual submit: stop the timer and block a second submit.
        form.addEventListener('submit', function(event) {
            if (isSubmitting) {
                event.preventDefault();
                return;
            }

            clearInterval(countdownId);
            lockForm();
        });

        tick();
        countdownId = setInterval(tick, 1000);
    })();
</script>