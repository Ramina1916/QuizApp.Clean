@model IEnumerable<QuizApp.Application.DTOs.Attempt.AttemptSummaryDto>

@{
    ViewData["Title"] = "My Quiz History";

    // Compute summary stats once
    var attempts = Model.ToList();
    var total = attempts.Count;
    double AvgPct(QuizApp.Application.DTOs.Attempt.AttemptSummaryDto a)
        => a.MaxScore > 0 ? (double)a.Score / a.MaxScore * 100 : 0;
    var average = total > 0 ? Math.Round(attempts.Average(AvgPct)) : 0;
    var best = total > 0 ? Math.Round(attempts.Max(AvgPct)) : 0;
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">My Quiz History</h1>
            <small class="text-muted">Track your progress and revisit past results.</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Browse Quizzes
        </a>
    </div>

    @if (total == 0)
    {
        <!-- Friendly empty state -->
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-clipboard-x text-muted" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-muted">No quizzes completed yet</h4>
                <p class="text-muted mb-4">Once you finish a quiz, your score will appear here.</p>
                <a asp-action="Index" class="btn btn-primary">Find a Quiz to Take</a>
            </div>
        </div>
    }
    else
    {
        <!-- Summary dashboard -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Quizzes Taken</div>
                        <div class="display-6 fw-bold">@total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Average Score</div>
                        <div class="display-6 fw-bold @(average >= 60 ? "text-success" : "text-danger")">@average%</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Best Score</div>
                        <div class="display-6 fw-bold text-primary">@best%</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Quiz</th>
                                <th scope="col">Score</th>
                                <th scope="col" style="min-width: 160px;">Performance</th>
                                <th scope="col">Completed</th>
                                <th scope="col" class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in attempts)
                            {
                                var pct = (int)Math.Round(AvgPct(a));
                                var barClass = pct >= 80 ? "bg-success"
                                             : pct >= 60 ? "bg-warning"
                                             : "bg-danger";

                                <tr>
                                    <td class="ps-4 fw-semibold">@a.QuizTitle</td>
                                    <td>
                                        <span class="fw-bold">@a.Score</span>
                                        <span class="text-muted">/ @a.MaxScore</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @barClass"
                                                     role="progressbar"
                                                     style="width: @pct%;"
                                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                                </div>
                                            </div>
                                            <small class="text-muted" style="min-width: 36px;">@pct%</small>
                                        </div>
                                    </td>
                                    <td class="text-muted small">
                                        @a.CompletedAt?.ToString("MMM dd, yyyy • hh:mm tt")
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Results" asp-route-id="@a.AttemptId"
                                           class="btn btn-sm btn-outline-primary">
                                            View Result
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>