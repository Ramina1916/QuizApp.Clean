@model QuizApp.Application.DTOs.Quiz.QuizDetailsDto

@{
    ViewData["Title"] = Model.Title;
    var isDraft = Model.Status == QuizApp.Domain.Enums.QuizStatus.Draft;
}

<div class="page-container">
    <a asp-controller="Quizzes" asp-action="Index" class="btn btn-link mb-3">← Back to quizzes</a>

    <!-- 1. Quiz Header & Stats -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="card-title mb-1">@Model.Title</h1>
                    <p class="text-muted mb-0">@(Model.Description ?? "No description provided.")</p>
                </div>
                <div>
                    @if (isDraft)
                    {
                        <span class="badge bg-warning text-dark fs-6">Draft</span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6">Published</span>
                    }
                </div>
            </div>

            <hr />

            <div class="d-flex gap-4 text-secondary">
                <span><i class="bi bi-question-circle"></i> @Model.Questions.Count questions</span>
                <span><i class="bi bi-clock"></i> @Model.TimeLimitMinutes minutes</span>
                <span><i class="bi bi-bar-chart"></i> @Model.Difficulty</span>
            </div>
        </div>
    </div>

    <!-- 2. Questions List -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Questions</h2>

        @if (Model.IsOwner && isDraft)
        {
            <a asp-action="AddQuestion" asp-route-quizId="@Model.Id" class="btn btn-primary btn-sm">
                + Add Question
            </a>
        }
    </div>

    @if (!Model.Questions.Any())
    {
        <div class="alert alert-info">
            This quiz has no questions yet.
            @if (Model.IsOwner && isDraft)
            {
                <text>Click "+ Add Question" to get started.</text>
            }
        </div>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var question in Model.Questions)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <div class="me-3">
                            <h5 class="mb-1">@question.Text</h5>
                            <div class="mt-2">
                                <span class="badge bg-info text-dark">@question.QuestionType</span>
                                <span class="badge bg-secondary">@question.Points pts</span>
                            </div>
                        </div>

                        <!-- Per-Question Actions (Only for Owner in Draft mode) -->
                        @if (Model.IsOwner && isDraft)
                        {
                            <div class="btn-group" role="group">
                                <a asp-action="EditQuestion"
                                   asp-route-quizId="@Model.Id"
                                   asp-route-Id="@question.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <form asp-action="RemoveQuestion"
                                      asp-route-questionId="@question.Id"
                                      asp-route-quizId="@Model.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this question?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- 3. Main Quiz Actions -->
    @if (Model.IsOwner)
    {
        <div class="card mt-4">
            <div class="card-body d-flex gap-2 flex-wrap">
                @if (isDraft)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">
                        Edit Quiz Details
                    </a>

                    <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success" onclick="return confirm('Publish this quiz? It will be visible to students.')">
                            Publish Quiz
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-success align-self-center fw-bold">Quiz is live and accepting submissions.</span>
                }
            </div>
        </div>
    }

    <!-- Take Quiz Button (Visible to everyone if published, or owner if draft) -->
    @if (Model.Status == QuizApp.Domain.Enums.QuizStatus.Active || Model.IsOwner)
    {
        <div class="mt-4 text-center">
            <form asp-controller="Quizzes" asp-action="Start" asp-route-quizId="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-lg btn-primary w-100">
                    Start Quiz
                </button>
            </form>
        </div>
    }
</div>