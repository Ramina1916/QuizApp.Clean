@model QuizApp.Application.DTOs.Quiz.EditQuizDto

@{
    ViewData["Title"] = "Edit Quiz";
}

<div class="page-container">

    <a asp-controller="Quizzes"
       asp-action="Details"
       asp-route-id="@Model.Id">
        ← Back to quiz details
    </a>

    <div class="quiz-edit-container">

        <h1>Edit Quiz</h1>

        <p>Update your quiz information below.</p>

        <form asp-controller="Quizzes"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <!-- Quiz Title -->
            <div class="form-group">
                <label asp-for="Title" class="form-label">
                    Quiz Title
                </label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter quiz title" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label asp-for="Description" class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter quiz description">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <!-- Category -->
            <div class="form-group">
                <label asp-for="Category" class="form-label">
                    Category
                </label>

                <input asp-for="Category"
                       class="form-control"
                       placeholder="Enter quiz category" />

                <span asp-validation-for="Category"
                      class="text-danger">
                </span>
            </div>

            <!-- Difficulty -->
            <div class="form-group">
                <label asp-for="Difficulty" class="form-label">
                    Difficulty
                </label>

                <select asp-for="Difficulty"
                        asp-items="Html.GetEnumSelectList<QuizApp.Domain.Enums.DifficultyLevel>()"
                        class="form-select">
                    <option value="">Select difficulty</option>
                </select>

                <span asp-validation-for="Difficulty"
                      class="text-danger">
                </span>
            </div>

            <!-- Time Limit -->
            <div class="form-group">
                <label asp-for="TimeLimitMinutes" class="form-label">
                    Time Limit (Minutes)
                </label>

                <input asp-for="TimeLimitMinutes"
                       type="number"
                       class="form-control"
                       min="1"
                       max="120" />

                <span asp-validation-for="TimeLimitMinutes"
                      class="text-danger">
                </span>
            </div>

            <!-- Actions -->
            <div class="form-actions">

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Quizzes"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}